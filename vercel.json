{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/open-library/subjects/:subject", "destination": "https://openlibrary.org/subjects/:subject" },
    { "source": "/open-library/works/:work", "destination": "https://openlibrary.org/works/:work" }
  ]
}
